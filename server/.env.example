# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of this API (used for shareable receipt links on WhatsApp)
APP_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────────────────────
# Either DATABASE_URL, or the individual DB_* values
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=showroompro
DB_SSL=false
DB_LOGGING=false

# ── Auth ──────────────────────────────────────────────────────────────────
# Use long random strings (>= 32 chars) in production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── File storage (Cloudinary) — receipts, product photos, staff documents ─
# Either CLOUDINARY_URL=cloudinary://key:secret@cloud_name, or the three values below
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Background reminders (low stock, due payments, recurring expenses) ────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60