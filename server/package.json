{
  "name": "showroompro-server",
  "version": "1.0.0",
  "private": true,
  "description": "ShowroomPro REST API — retail showroom operations (suppliers, inventory, POS, expenses, payroll, finance, reports)",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "migration:run": "tsx scripts/migrate.ts run",
    "migration:revert": "tsx scripts/migrate.ts revert",
    "seed": "tsx scripts/seed.ts",
    "create-business": "tsx scripts/createBusiness.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
